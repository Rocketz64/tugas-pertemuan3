generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  balance   Float
}

model Transaction {
  id          Int      @id @default(autoincrement())
  type        String
  amount      Float
  date        DateTime
  description String?
  userId      Int
}